{
  "name": "@local/dsh-workflow-view",
  "version": "1.0.2",
  "private": false,
  "type": "module",
  "description": "A side-panel view of the runs the DeepSeek Harness `workflow` tool starts: one row per run, its phases and every member agent, with live status, route and tokens, plus a link into each member session.",
  "license": "Apache-2.0",
  "author": "Daniel",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dannielcordeiro/dsh-egm.git",
    "directory": "packages/workflow-view"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workflow",
    "subagents"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=22 <25"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build:client": "node ../../scripts/bundle-client.mjs",
    "check": "node --check src/index.js && node --check src/client.js && node ../../scripts/bundle-client.mjs --check",
    "test": "node --test test/*.test.js"
  }
}
